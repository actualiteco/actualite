                    "401": {
                        "description": "Неверные учетные данные",
                        "schema": {
                            "$ref": "#/definitions/actualiteco_actualite_internal_core_domain.CustomError"
                        }
                    },
                    "404": {
                        "description": "У поста нет комментариев",
