{
    "swagger": "2.0",
    "info": {
        "title": "actualiteco/actualite",
        "contact": {},
        "version": "1.0"
    },
    "host": "127.0.0.1:8080",
    "paths": {
        "/login": {
            "post": {
                "description": "Авторизует пользователя по email и паролю, возвращает JWT",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Auth"
                ],
                "summary": "Авторизация по email и паролю",
                "parameters": [
                    {
                        "description": "тело запроса",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/internal_features_auth_transport_http.LoginDTO"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Успешная авторизация",
                        "schema": {
                            "$ref": "#/definitions/internal_features_auth_transport_http.LoginDTOResponse"
                        }
                    },
                    "400": {
                        "description": "Невалидный запрос",
                        "schema": {
                            "$ref": "#/definitions/actualiteco_actualite_internal_core_domain.CustomError"
                        }
                    },
                    "401": {
                        "description": "Неверные учётные данные",
                        "schema": {
                            "$ref": "#/definitions/actualiteco_actualite_internal_core_domain.CustomError"
                        }
                    },
                    "500": {
                        "description": "Внутренняя ошибка сервера",
                        "schema": {
                            "$ref": "#/definitions/actualiteco_actualite_internal_core_domain.InternalError"
                        }
                    }
                }
            }
        },
        "/profile": {
            "patch": {
                "description": "Обновить профиль пользователя (display_name, username, status)",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Profile"
                ],
                "summary": "Обновить профиль пользователя",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Bearer \u003cjwt токен\u003e",
                        "name": "Authorization",
                        "in": "header",
                        "required": true
                    },
                    {
                        "description": "Информация профиля",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/internal_features_profile_transport_http.UpdateProfileRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Успешный запрос",
                        "schema": {
                            "$ref": "#/definitions/internal_features_profile_transport_http.ProfileResponse"
                        }
                    },
                    "400": {
                        "description": "Неверный запрос",
                        "schema": {
                            "$ref": "#/definitions/actualiteco_actualite_internal_core_domain.CustomError"
                        }
                    },
                    "403": {
                        "description": "Пользователь неавторизован",
                        "schema": {
                            "$ref": "#/definitions/actualiteco_actualite_internal_core_domain.CustomError"
                        }
                    },
                    "409": {
                        "description": "Пользователь с таким юзернеймом уже существует",
                        "schema": {
                            "$ref": "#/definitions/actualiteco_actualite_internal_core_domain.CustomError"
                        }
                    },
                    "500": {
                        "description": "Внутренняя ошибка сервера",
                        "schema": {
                            "$ref": "#/definitions/actualiteco_actualite_internal_core_domain.InternalError"
                        }
                    }
                }
            }
        },
        "/profile/me": {
            "get": {
                "description": "Получить профиль пользователя с постами по JWT",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Profile"
                ],
                "summary": "Получить профиль пользователя по JWT",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Bearer \u003cjwt токен\u003e",
                        "name": "Authorization",
                        "in": "header",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/internal_features_profile_transport_http.ProfileResponse"
                        }
                    },
                    "400": {
                        "description": "Неверный запрос",
                        "schema": {
                            "$ref": "#/definitions/actualiteco_actualite_internal_core_domain.CustomError"
                        }
                    },
                    "403": {
                        "description": "Пользователь неавторизован",
                        "schema": {
                            "$ref": "#/definitions/actualiteco_actualite_internal_core_domain.CustomError"
                        }
                    },
                    "500": {
                        "description": "Внутренняя ошибка сервера",
                        "schema": {
                            "$ref": "#/definitions/actualiteco_actualite_internal_core_domain.InternalError"
                        }
                    }
                }
            }
        },
        "/profile/{userID}": {
            "get": {
                "description": "Получить профиль пользователя с постами по id пользователя",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Profile"
                ],
                "summary": "Получить профиль пользователя",
                "parameters": [
                    {
                        "type": "string",
                        "description": "User ID",
                        "name": "userID",
                        "in": "path",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "Bearer \u003cjwt токен\u003e",
                        "name": "Authorization",
                        "in": "header",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/internal_features_profile_transport_http.ProfileResponse"
                        }
                    },
                    "400": {
                        "description": "Неверный запрос",
                        "schema": {
                            "$ref": "#/definitions/actualiteco_actualite_internal_core_domain.CustomError"
                        }
                    },
                    "403": {
                        "description": "Пользователь неавторизован",
                        "schema": {
                            "$ref": "#/definitions/actualiteco_actualite_internal_core_domain.CustomError"
                        }
                    },
                    "500": {
                        "description": "Внутренняя ошибка сервера",
                        "schema": {
                            "$ref": "#/definitions/actualiteco_actualite_internal_core_domain.InternalError"
                        }
                    }
                }
            }
        },
        "/profile/{userID}/follow": {
            "post": {
                "description": "Подписаться авторизованным пользователем на другого пользователя по userID",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Profile"
                ],
                "summary": "Подписаться на пользователя",
                "parameters": [
                    {
                        "type": "string",
                        "description": "User ID",
                        "name": "userID",
                        "in": "path",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "Bearer \u003cjwt токен\u003e",
                        "name": "Authorization",
                        "in": "header",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Успешный запрос",
                        "schema": {
                            "$ref": "#/definitions/internal_features_profile_transport_http.FollowResponse"
                        }
                    },
                    "400": {
                        "description": "Неверный запрос (в т.ч. подписка на себя или повторная подписка)",
                        "schema": {
                            "$ref": "#/definitions/actualiteco_actualite_internal_core_domain.CustomError"
                        }
                    },
                    "401": {
                        "description": "Пользователь неавторизован",
                        "schema": {
                            "$ref": "#/definitions/actualiteco_actualite_internal_core_domain.CustomError"
                        }
                    },
                    "404": {
                        "description": "Пользователь не найден",
                        "schema": {
                            "$ref": "#/definitions/actualiteco_actualite_internal_core_domain.CustomError"
                        }
                    },
                    "500": {
                        "description": "Внутренняя ошибка сервера",
                        "schema": {
                            "$ref": "#/definitions/actualiteco_actualite_internal_core_domain.InternalError"
                        }
                    }
                }
            }
        },
        "/profile/{userID}/unfollow": {
            "post": {
                "description": "Отписаться авторизованным пользователем от другого пользователя по userID",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Profile"
                ],
                "summary": "Отписаться от пользователя",
                "parameters": [
                    {
                        "type": "string",
                        "description": "User ID",
                        "name": "userID",
                        "in": "path",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "Bearer \u003cjwt токен\u003e",
                        "name": "Authorization",
                        "in": "header",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Успешный запрос",
                        "schema": {
                            "$ref": "#/definitions/internal_features_profile_transport_http.FollowResponse"
                        }
                    },
                    "400": {
                        "description": "Неверный запрос (в т.ч. отписка от себя или отсутствие подписки)",
                        "schema": {
                            "$ref": "#/definitions/actualiteco_actualite_internal_core_domain.CustomError"
                        }
                    },
                    "401": {
                        "description": "Пользователь неавторизован",
                        "schema": {
                            "$ref": "#/definitions/actualiteco_actualite_internal_core_domain.CustomError"
                        }
                    },
                    "500": {
                        "description": "Внутренняя ошибка сервера",
                        "schema": {
                            "$ref": "#/definitions/actualiteco_actualite_internal_core_domain.InternalError"
                        }
                    }
                }
            }
        },
        "/register": {
            "post": {
                "description": "Создаёт нового пользователя и возвращает его данные",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Auth"
                ],
                "summary": "Регистрация пользователя",
                "parameters": [
                    {
                        "description": "тело запроса",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/internal_features_auth_transport_http.RegisterDTO"
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Пользователь создан",
                        "schema": {
                            "$ref": "#/definitions/internal_features_auth_transport_http.RegisterDTOResponse"
                        }
                    },
                    "400": {
                        "description": "Неверный запрос или email уже занят",
                        "schema": {
                            "$ref": "#/definitions/actualiteco_actualite_internal_core_domain.CustomError"
                        }
                    },
                    "500": {
                        "description": "Внутренняя ошибка сервера",
                        "schema": {
                            "$ref": "#/definitions/actualiteco_actualite_internal_core_domain.InternalError"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "actualiteco_actualite_internal_core_domain.CustomError": {
            "type": "object",
            "properties": {
                "code": {
                    "type": "string"
                },
                "message": {
                    "type": "string",
                    "example": "invalid request"
                }
            }
        },
        "actualiteco_actualite_internal_core_domain.InternalError": {
            "type": "object",
            "properties": {
                "code": {
                    "type": "string",
                    "enum": [
                        "INTERNAL_ERROR"
                    ]
                },
                "message": {
                    "type": "string"
                }
            }
        },
        "internal_features_auth_transport_http.LoginDTO": {
            "type": "object",
            "required": [
                "email",
                "password"
            ],
            "properties": {
                "email": {
                    "type": "string",
                    "example": "test.user@email.com"
                },
                "password": {
                    "type": "string",
                    "maxLength": 64,
                    "minLength": 8,
                    "example": "hashpassword"
                }
            }
        },
        "internal_features_auth_transport_http.LoginDTOResponse": {
            "type": "object",
            "properties": {
                "token": {
                    "type": "string",
                    "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJleHAiOjE3OTM2NjUxNzcsImlhdCI6MTc5MzYyMTk3NywiVXNlcklkIjoiODc5NGU1ODktMGRkYi00M2NlLTlmOTItMTZmYWFmY2Y0ZWU0IiwiUm9sZSI6InVzZXIifQ.iv_JT1Fke-QaK2nx2FEF_pkDroyJP-_xK81egOAV7h4"
                },
                "user_id": {
                    "type": "string",
                    "example": "8794e589-0ddb-43ce-9f92-16faafcf4ee4"
                },
                "username": {
                    "type": "string",
                    "example": "username"
                }
            }
        },
        "internal_features_auth_transport_http.RegisterDTO": {
            "type": "object",
            "required": [
                "email",
                "password",
                "role"
            ],
            "properties": {
                "email": {
                    "type": "string",
                    "x-order": "0",
                    "example": "m4rkek@gmail.com"
                },
                "username": {
                    "type": "string",
                    "x-order": "1",
                    "example": "m4rkek"
                },
                "password": {
                    "type": "string",
                    "maxLength": 64,
                    "minLength": 8,
                    "x-order": "2",
                    "example": "supersecretpass"
                },
                "role": {
                    "type": "string",
                    "x-order": "3",
                    "example": "admin"
                }
            }
        },
        "internal_features_auth_transport_http.RegisterDTOResponse": {
            "type": "object",
            "properties": {
                "id": {
                    "type": "string",
                    "x-order": "0",
                    "example": "3fa85f64-5717-4562-b3fc-2c963f66afa6"
                },
                "username": {
                    "type": "string",
                    "x-order": "1",
                    "example": "m4rkek"
                },
                "email": {
                    "type": "string",
                    "x-order": "2",
                    "example": "m4rkek@gmail.com"
                },
                "role": {
                    "type": "string",
                    "x-order": "3",
                    "example": "user"
                },
                "createdAt": {
                    "type": "string",
                    "x-order": "4",
                    "example": "2026-03-25T12:00:41.267Z"
                }
            }
        },
        "internal_features_profile_transport_http.FollowResponse": {
            "type": "object",
            "properties": {
                "message": {
                    "type": "string",
                    "example": "success"
                }
            }
        },
        "internal_features_profile_transport_http.ProfileResponse": {
            "type": "object",
            "properties": {
                "avatar_url": {
                    "type": "string",
                    "example": "http://localhost:8080/avatar_url"
                },
                "created_at": {
                    "type": "string",
                    "example": "2006-01-02T15:04:05Z07:00"
                },
                "display_name": {
                    "type": "string",
                    "example": "mark"
                },
                "email": {
                    "type": "string",
                    "example": "test.user@email.com"
                },
                "email_verified": {
                    "type": "boolean",
                    "example": false
                },
                "followers_count": {
                    "type": "integer",
                    "example": 10
                },
                "following_count": {
                    "type": "integer",
                    "example": 5
                },
                "id": {
                    "type": "string",
                    "example": "8794e589-0ddb-43ce-9f92-16faafcf4ee4"
                },
                "role": {
                    "type": "string",
                    "example": "user"
                },
                "status": {
                    "type": "string",
                    "example": "something smart"
                },
                "username": {
                    "type": "string",
                    "example": "username"
                }
            }
        },
        "internal_features_profile_transport_http.UpdateProfileRequest": {
            "type": "object",
            "properties": {
                "display_name": {
                    "type": "string",
                    "example": "mark"
                },
                "status": {
                    "type": "string",
                    "example": "something smart"
                },
                "username": {
                    "type": "string",
                    "example": "username"
                }
            }
        }
    }
}